# ==========================================
# DIGIHUB CONFIGURATION
# ==========================================

# Server Port
PORT=8080

# SQLite Database File
DATABASE_PATH=storeku.db

# ------------------------------------------
# DIGITALCORE API (UPSTREAM STOCK & LICENSE)
# ------------------------------------------
# Base URL: https://digitalcore.top
DIGITALCORE_BASE_URL=https://digitalcore.top
# API Key diperoleh dari bot Telegram @DCoreStoreBot -> ⚙️ Reseller API
DIGITALCORE_API_KEY=your_digitalcore_api_key_here

# ------------------------------------------
# PAYMENTG (AUTOMATED SHOPEEPAY QRIS)
# ------------------------------------------
# Mode Sandbox: https://paymentg.syukurapi.online/api/sandbox
# Mode Live:    https://paymentg.syukurapi.online/api
PAYMENTG_API_URL=https://paymentg.syukurapi.online/api/sandbox
PAYMENTG_API_KEY=ak_sbx_demo_key

# ------------------------------------------
# ADMIN CREDENTIALS & SECURITY
# ------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SECRET_KEY=change_this_to_a_secure_random_secret_token

# ------------------------------------------
# PRICING ENGINE (USD TO IDR)
# ------------------------------------------
# Nilai tukar 1 USD ke Rupiah
USD_TO_IDR_RATE=16200
# Persentase keuntungan (contoh 25 berarti +25%)
PROFIT_MARGIN_PERCENT=25
# Margin tetap tambahan per item (IDR)
PROFIT_MARGIN_FIXED=2000

# ------------------------------------------
# RESEND EMAIL SERVICE
# ------------------------------------------
# Masukkan API Key Resend Anda (diawali re_...)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Alamat pengirim resmi Digimest
RESEND_FROM_EMAIL=Digimest <orders@digimest.tech>
STORE_BASE_URL=https://digimest.tech

# ------------------------------------------
# SUPPORT & TELEGRAM CS CONFIGURATION
# ------------------------------------------
# Username Telegram Support / Reseller (tanpa tanda @)
TELEGRAM_SUPPORT_USERNAME=Digimestsupport
